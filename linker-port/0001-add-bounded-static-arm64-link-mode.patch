+// Fixed-load ARM64 entry metadata. The future firmware loader must establish
+// its own stack, mappings, exception level and boot arguments; this record does
+// not perform any of those operations.
+class LCAtlanticUnixThread final : public LoadCommand {
+public:
+  uint32_t getSize() const override {
+    return 4 * sizeof(uint32_t) + sizeof(arm_thread_state64_t);
+  }
+  void writeTo(uint8_t *buf) const override {
+    write32le(buf, LC_UNIXTHREAD);
+    write32le(buf + 4, getSize());
+    write32le(buf + 8, ARM_THREAD_STATE64);
+    write32le(buf + 12, ARM_THREAD_STATE64_COUNT);
+    memset(buf + 16, 0, sizeof(arm_thread_state64_t));
+    write64le(buf + 16 + offsetof(arm_thread_state64_t, pc), config->entry->getVA());
+  }
+};
