+/* Native formatting subset retained verbatim for the Mach-only firmware. */
+#include <kern/atlantic_printf.h>
+#include <kern/misc_protos.h>
+#include <mach/boolean.h>
+
+struct snprintf_arg {
+	char *str;
+	size_t remain;
+};
+
+static void
+snprintf_func(int ch, void *arg)
+{
+	struct snprintf_arg *const info = arg;
+
+	if (info->remain >= 2) {
+		*info->str++ = (char)ch;
+		info->remain--;
+	}
+}
+
+int
+vsnprintf(char *str, size_t size, const char *format, va_list ap)
+{
+	struct snprintf_arg info;
+	int retval;
+
+	info.str = str;
+	info.remain = size;
+	retval = __doprnt(format, ap, snprintf_func, &info, 10, FALSE);
+	if (info.remain >= 1) {
+		*info.str++ = '\0';
+	}
+	return retval;
+}
+
+int
+snprintf(char *str, size_t size, const char *format, ...)
+{
+	int retval;
+	va_list ap;
+
+	va_start(ap, format);
+	retval = vsnprintf(str, size, format, ap);
+	va_end(ap);
+	return retval;
+}
+
