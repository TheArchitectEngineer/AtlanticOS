@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: MIT */
+/* AtlanticOS declarations for retained native XNU formatting routines. */
+#ifndef ATLANTIC_PRINTF_H
+#define ATLANTIC_PRINTF_H
+#include <stddef.h>
+#include <stdarg.h>
+extern int snprintf(char *, size_t, const char *, ...) __attribute__((format(printf, 3, 4)));
+extern int vsnprintf(char *, size_t, const char *, va_list) __attribute__((format(printf, 3, 0)));
+#endif
