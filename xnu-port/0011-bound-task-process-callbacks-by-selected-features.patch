 #endif
+
+/* Native metadata provider owns the actual combined proc/task allocation. */
+extern struct proc *kernproc;
+extern int proc_check_footprint_priv(void);
 
 SECURITY_READ_ONLY_LATE(task_t) kernel_task;
 
@@ -921,7 +925,10 @@
 	thread_t       thread)
 {
 	ipc_space_policy_t pol = ipc_policy_for_task(task);
-	bool movable_allowed = mac_task_check_get_movable_control_port() == 0;
+	bool movable_allowed = false;
+#if CONFIG_MACF
+	movable_allowed = mac_task_check_get_movable_control_port() == 0;
+#endif
 	bool is_simulated = pol & IPC_SPACE_POLICY_SIMULATED;
 	bool is_translated = false;
 
@@ -1039,7 +1046,13 @@
 bool
 task_is_initproc(task_t task)
 {
+#ifdef MACH_BSD
 	return get_bsdtask_info(task) == initproc;
+#else
+	/* No init process exists in the firmware profile; grant no init privilege. */
+	(void)task;
+	return false;
+#endif
 }
 
 boolean_t
@@ -2879,6 +2892,7 @@
