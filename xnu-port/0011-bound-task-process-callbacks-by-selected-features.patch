 		platform = proc_platform(p);
@@ -6005,6 +6050,8 @@
 #endif /* DEVELOPMENT || DEBUG */
 		}
 #endif /* __arm64__ */
+
+#endif
 
 		if (*task_info_count < TASK_VM_INFO_REV0_COUNT) {
 			error = KERN_INVALID_ARGUMENT;
@@ -6209,10 +6256,13 @@
 			*task_info_count = TASK_VM_INFO_REV3_COUNT;
 		}
