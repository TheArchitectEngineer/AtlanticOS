 	}
 
 	return kr;
@@ -4346,9 +4378,13 @@
 		itk_unlock(task);
 		is_write_unlock(space);
 		if (kr == KERN_SUCCESS) {
+#ifdef MACH_BSD
 			printf("warning: %s(%d) performed out-of-band resume on pid %d\n",
 			    proc_name_address(get_bsdtask_info(current_task())), proc_pid(get_bsdtask_info(current_task())),
