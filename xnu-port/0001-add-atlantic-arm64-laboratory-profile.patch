+/* SPDX-License-Identifier: MIT
+ * Original AtlanticOS laboratory compile profile. Not a Moto G20 BSP.
+ * ARMv8-A, one CPU, 4 KiB translation granule, QEMU Cortex-A57 cache model.
+ * No Apple PAC, SME, AIC, CTRR, KTRR, SPTM or monitor features are selected.
+ */
+#ifndef ATLANTIC_XNU_LAB_BOARD_H
+#define ATLANTIC_XNU_LAB_BOARD_H
+#define ATLANTIC_ARM64_LAB 1
+#define __ARM_ARCH__ 8
+#define __ARM_VMSA__ 8
+#define __ARM_VFP__ 4
+#define __ARM_COHERENT_CACHE__ 1
+#define __ARM_COHERENT_IO__ 1
+#define __ARM_IC_NOALIAS_ICACHE__ 1
+#define __ARM_DEBUG__ 7
+#define MAX_L2_CLINE 6
+#define MAX_CPUS 1
+#define MAX_CPU_CLUSTERS 1
+#define NO_MONITOR 1
+#define NO_ECORE 1
+#define ARM_ARCH_TIMER 1
+/* Metadata has two fixed slots; no hardware counter backend is enabled. */
+#define CORE_NCTRS 2
+#if CONFIG_CPU_COUNTERS
+#error AtlanticOS laboratory PMU backend is not implemented
+#endif
+#endif
